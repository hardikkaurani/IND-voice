# IND-voice Environment Configuration Template
# COPY THIS FILE TO .env IN YOUR LOCAL ENVIRONMENT. NEVER COMMIT .env TO VERSION CONTROL.

# Backend Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","https://ind-voice.vercel.app"]

# Database Configuration (SQLite for local development, PostgreSQL for production)
DATABASE_URL=sqlite:///./ind_voice.db
# Example for Render PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@host.render.com:5432/ind_voice

# Gnani AI Configuration (Prisma STT & Timbre TTS)
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# Optional: Evon Self-Hosted Foundation Model (OpenAI-compatible endpoint)
EVON_API_BASE_URL=
EVON_API_KEY=
EVON_MODEL_NAME=gnani/gnani-evon-v3.3-30B-A3B

# Audio & Processing Limits
MAX_AUDIO_SIZE_MB=15
MAX_RECORDING_DURATION_SECONDS=60

# Frontend Configuration (Exposed to browser)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="IND-voice"
NEXT_PUBLIC_APP_TAGLINE="Bol Kar Likho — Voice-First Business Ledger"
